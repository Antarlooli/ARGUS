{
  "manifest_version": 3,
  "name": "Argus",
  "version": "0.1.0",
  "description": "A calm, watchful console for every feed you follow — social, news, and boards in one panel deck.",
  "browser_specific_settings": {
    "gecko": {
      "id": "argus@jdoe.dev",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo", "websiteContent"]
      }
    }
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://bsky.social/*", "https://a.4cdn.org/*", "https://i.4cdn.org/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "scripts": ["background.js"], "type": "module" },
  "action": { "default_title": "Open Argus", "default_icon": { "48": "icons/icon-48.png" } },
  "icons": { "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png" }
}
